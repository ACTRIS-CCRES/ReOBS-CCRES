#!Jinja2

# Slurm directives : https://slurm.schedmd.com/srun.html
# Parameters
# -------------------------------------------------------------------------------------
# directory

# Lance le 5 du mois
{% import "datetime" as dt %}
{% set current_date = dt.datetime.now() %}
{% set yyyymm = dt.datetime.strftime(current_date, "%Y%m") %}

# COMMON VARIABLES
{% set USER = environ['USER'] %}

{% if "REOBS_BASE_DIR" in environ%}
    {% set BASE_DIR = environ["REOBS_BASE_DIR"] %}
{% else %}
    {% set BASE_DIR ="/home/" + USER + "/flux/ReOBS-CCRES"%}
{% endif %}

{% if "REOBS_CONDA_ENV" in environ%}
    {% set CONDA_ENV = environ["REOBS_CONDA_ENV"] %}
{% else %}
    {% set CONDA_ENV = "/homedata/ccres/python_envs/reobs" %}
{% endif %}

{% if "REOBS_CONFIG_FILE" in environ%}
    {% set superviseur_config = environ["REOBS_CONFIG_FILE"] %}
{% elif "REOBS_PROD" in environ and environ["REOBS_PROD"] in ('true', '1', 't')%}
    {% set superviseur_config = BASE_DIR + "/configs/treatments/superviseur.cfg" %}
{% else %}
    {% set superviseur_config = BASE_DIR + "/configs/treatments/superviseur.dev.cfg" %}
{% endif %}

{% if "REOBS_SUPERVISOR_OPTIONS" in environ%}
    {% set superviseur_options=environ["REOBS_SUPERVISOR_OPTIONS"] %}
{% else %}
    {% set superviseur_options="" %}
{% endif %}

{% if "REOBS_DATE" in environ%}
    {% set date=environ["REOBS_DATE"] %}
{% else %}
    {% set date="auto" %}
{% endif %}

{% set superviseur = BASE_DIR + "/src/reobs/reobs/cli/superviseur/superviseur.sh" %}
{% set reobs_cli = BASE_DIR + "/src/reobs/reobs/cli/reobs_cli.py" %}
{% set deploy_script = BASE_DIR + "/configs/workflows/scripts/deploy_on_site.py" %}
{% set download = BASE_DIR +  "/src/data-downloader/get_cloudnet_products.py" %}
{% set download_config = BASE_DIR + "/src/data-downloader/reobs-ccres_download.toml" %}
{% set download_env = BASE_DIR + "/Reobs_ccres_cylc_visualisations/bin/activate" %}

[meta]
    title = "ReOBS/CCRES production mensuelles"

[task parameters]
    listesites = {{LISTESITES|join(",")}}
    listefilieres = {{LISTEFILIERES|join(",")}}
# contact
    {% set email_from = EMAIL_FROM %}
    {% set email_to = EMAIL_TO %}


[scheduler]
    UTC mode = True
    allow implicit tasks = True

[scheduling]
    initial cycle point = now
    runahead limit = PT1H
    [[special tasks]]
        clock-trigger = lancement

    [[graph]]
        P1M = """
            lancement [-P1M] => lancement => telechargement_cloudnet<listesites> => cloudnet<listefilieres,listesites>
            cloudnet<listefilieres,listesites> & cloudnet<listefilieres=doppler_lidar,listesites> => construct_final_2D<listesites> => fin
"""
# NE FONCTIONNE PAS ENCORE
# => construct_final_2D => fin

[runtime]
    [[root]] # suite defaults
    init-script = """
                module unload nco
                module load nco
                echo Setting up conda environement
                eval "$(conda shell.bash hook)"
                conda activate {{ CONDA_ENV }}
                echo Conda environment {{ CONDA_ENV }} set.
                echo $(which python) set.
                """
    platform = slurm_local
    submission retry delays = PT5M, PT10M
    execution retry delays = PT5M, PT10M

    [[fin]]
      script =  """ sleep 5;  echo fin lancement mensuelle ccres  """
        [[[directives]]]
            --time = 00:00:10
            --mem = 3500mb
            --nodes = 1
            --cpus-per-task = 1

    [[lancement]]
        script = """ echo lancement mensuelle ccres date : $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d")
"""
        [[[directives]]]
            --time = 00:00:10
            --mem = 3500mb
            --nodes = 1
            --cpus-per-task = 1

    [[telechargement_cloudnet<listesites>]]
        submission polling intervals = PT1M
        execution polling intervals = PT5M

        script = """
        source {{download_env}}
        echo "{{download}} --config {{download_config}} --site $CYLC_TASK_PARAM_listesites --date-from $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01") --date-to $(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d")"
        {{download}} --config {{download_config}} --site $CYLC_TASK_PARAM_listesites --date-from $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01") --date-to $(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d")
"""
        [[[events]]]
        mail events = failed, execution timeout, submission failed
        [[[mail]]]
            from = {{email_from}}
            to = {{email_to}}
        [[[directives]]]
            --time = 01:00:00
            --mem = 3500mb
            --nodes = 1
            --cpus-per-task = 1

    [[construct_final_2D<listesites>]]
        submission polling intervals = PT1M
        execution polling intervals = PT5M

        script = """
        echo "{{superviseur}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s $CYLC_TASK_PARAM_listesites -f construct_final_2D -c {{superviseur_config}}"
        {{superviseur}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s $CYLC_TASK_PARAM_listesites -f construct_final_2D -c {{superviseur_config}}
"""
        [[[events]]]
            mail events = failed, execution timeout, submission failed
        [[[mail]]]
            from = {{email_from}}
            to = {{email_to}}

        [[[directives]]]
            --time = 24:00:00
            --mem = 15500mb
	    --partition=zen16
            --nodes = 1
            --cpus-per-task = 1

    [[cloudnet<listefilieres=doppler_lidar><listesites>]]
        submission polling intervals = PT1M
        execution polling intervals = PT5M

        script = """
        echo  "{{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s ccres_$CYLC_TASK_PARAM_listesites -f cloudnet_$CYLC_TASK_PARAM_listefilieres -c {{superviseur_config}}"
        {{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s ccres_$CYLC_TASK_PARAM_listesites -f cloudnet_$CYLC_TASK_PARAM_listefilieres -c {{superviseur_config}}
"""
        [[[events]]]
            mail events = failed, execution timeout, submission failed
        [[[mail]]]
            from = {{email_from}}
            to = {{email_to}}

        [[[directives]]]
            --time = 01:00:00
            --mem = 8000mb
	    --partition=zen16
            --nodes = 1
            --cpus-per-task = 1

    [[cloudnet<listefilieres><listesites>]]
        submission polling intervals = PT1M
        execution polling intervals = PT5M

        script = """
        echo  "{{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s ccres_$CYLC_TASK_PARAM_listesites -f cloudnet_$CYLC_TASK_PARAM_listefilieres -c {{superviseur_config}}"
        {{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s ccres_$CYLC_TASK_PARAM_listesites -f cloudnet_$CYLC_TASK_PARAM_listefilieres -c {{superviseur_config}}
"""
        [[[events]]]
            mail events = failed, execution timeout, submission failed
        [[[mail]]]
            from = {{email_from}}
            to = {{email_to}}

        [[[directives]]]
            --time = 01:00:00
            --mem = 3500mb
	    --partition=zen4
            --nodes = 1
            --cpus-per-task = 1
