#!Jinja2

# Slurm directives : https://slurm.schedmd.com/srun.html
# Parameters
# -------------------------------------------------------------------------------------
# directory

# Lance le 5 du mois
{% import "datetime" as dt %}
{% set current_date = dt.datetime.now() %}
{% set yyyymm = dt.datetime.strftime(current_date, "%Y%m") %}

# COMMON VARIABLES
{% set USER = environ['USER'] %}

{% if "REOBS_BASE_DIR" in environ%}
    {% set BASE_DIR = environ["REOBS_BASE_DIR"] %}
{% else %}
    {% set BASE_DIR ="/home/" + USER + "/flux/ReOBS-CCRES"%}
{% endif %}

{% if "REOBS_CONDA_ENV" in environ%}
    {% set CONDA_ENV = environ["REOBS_CONDA_ENV"] %}
{% else %}
    {% set CONDA_ENV = "/homedata/ccres/python_envs/reobs" %}
{% endif %}

{% if "REOBS_CONFIG_FILE" in environ%}
    {% set superviseur_config = environ["REOBS_CONFIG_FILE"] %}
{% elif "REOBS_PROD" in environ and environ["REOBS_PROD"] in ('true', '1', 't')%}
    {% set superviseur_config = BASE_DIR + "/configs/treatments/superviseur.cfg" %}
{% else %}
    {% set superviseur_config = BASE_DIR + "/configs/treatments/superviseur.dev.cfg" %}
{% endif %}

{% if "REOBS_SUPERVISOR_OPTIONS" in environ%}
    {% set superviseur_options=environ["REOBS_SUPERVISOR_OPTIONS"] %}
{% else %}
    {% set superviseur_options="" %}
{% endif %}

{% if "REOBS_DATE" in environ%}
    {% set date=environ["REOBS_DATE"] %}
{% else %}
    {% set date="auto" %}
{% endif %}

{% set superviseur = BASE_DIR + "src/reobs/reobs/cli/superviseur/superviseur.sh" %}
{% set reobs_cli = BASE_DIR + "src/reobs/reobs/cli/reobs_cli.py" %}
{% set deploy_script = BASE_DIR + "configs/workflows/scripts/deploy_on_site.py" %}

# SPECIFIC
{% set site = "ccres_palaiseau" %}

[meta]
    title = "ReOBS/CCRES PALAISEAU production"

[scheduler]
    UTC mode = True

[scheduling]
    initial cycle point = now
    runahead limit = PT1H
    [[special tasks]]
        clock-trigger = lancement

    [[graph]]
        P1M = """
            lancement [-P1M] => lancement => telechargement_cloudnet => cloudnet_categorize & cloudnet_classification & cloudnet_der & cloudnet_drizzle & cloudnet_ier & cloudnet_iwc & cloudnet_lidar & cloudnet_doppler_lidar & cloudnet_doppler_lidar_wind & cloudnet_doppler_lidar_epsilon & cloudnet_lwc & cloudnet_mwr_multi & cloudnet_mwr_l1c & cloudnet_mwr_single & cloudnet_mwr_single_ah & cloudnet_radar & cloudnet_disdrometer & cloudnet_disdrometer_raw & cloudnet_meteo => fin
"""
# => construct_final_2D => fin

[runtime]
    [[root]] # suite defaults
    init-script = """
                module unload nco
                module load nco
                echo Setting up conda environement
                eval "$(conda shell.bash hook)"
                conda activate {{ CONDA_ENV }}
                echo Conda environment {{ CONDA_ENV }} set.
                echo $(which python) set.
                """
    platform = slurm_local
    submission retry delays = PT1M, PT1M, PT1H
    execution retry delays = PT1M, PT1M, PT1H

    [[fin]]
      script =  """ sleep 5;  echo fin lancement mensuelle ccres {{ site }} """
        [[[directives]]]
            --time = 00:00:10
            --mem = 3500mb
            --nodes = 1
            --cpus-per-task = 1

    [[lancement]]
        script = """ echo lancement mensuelle ccres {{ site }}  date : $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d")
"""
        [[[directives]]]
            --time = 00:00:10
            --mem = 3500mb
            --nodes = 1
            --cpus-per-task = 1

    [[telechargement_cloudnet]]
        script = """ echo telechargement_cloudnet {{ site }} date : $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d")
"""
        [[[directives]]]
            --time = 00:00:10
            --mem = 3500mb
            --nodes = 1
            --cpus-per-task = 1

    [[construct_final_2D]]
        script = """
        echo "{{superviseur}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s {{site}} -f construct_final_2D -c {{superviseur_config}}"
       {{superviseur}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s {{site}} -f construct_final_2D -c {{superviseur_config}}
"""
        [[[directives]]]
            --time = 24:00:00
            --mem = 15500mb
	    --partition=zen16
            --nodes = 1
            --cpus-per-task = 1

    [[cloudnet_categorize]]
        script = """
        echo "{{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s {{site}} -f cloudnet_categorize -c {{superviseur_config}}"
        {{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s {{site}} -f cloudnet_categorize -c {{superviseur_config}}
"""

        [[[directives]]]
            --time = 04:00:00
            --mem = 3500mb
            --nodes = 1
            --cpus-per-task = 1

    [[cloudnet_classification]]
        script = """
        echo  "{{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s {{site}} -f cloudnet_classification -c {{superviseur_config}}"
        {{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s {{site}} -f cloudnet_classification -c {{superviseur_config}}
"""

        [[[directives]]]
