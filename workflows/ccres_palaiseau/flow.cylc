        {{superviseur}} {{superviseur_options}} -o init_catalog -d $(date -d "{{yyyymm}}01 - 6 month" +"%Y%m01")-$(date -d "{{yyyymm}}01 - 5 month - 1 day" +"%Y%m%d") -s {{site}} -f cloudnet_der -c {{superviseur_config}}
